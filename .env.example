# Upstash Redis (REST). Vercel's Upstash/KV integration sets the KV_* names automatically.
# Placeholders only - put real values in .env.local (never commit them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: pin the public origin used in share links (no trailing slash needed).
# Recommended in production, e.g. https://your-app.vercel.app
# Origin only: http(s)://host[:port] - no user:pass@, path, ?query or #fragment.
# APP_BASE_URL=

# Set to 1 to honour the x-test-now-ms request header for expiry logic
TEST_MODE=0
